#!/usr/bin/env python3
"""Quita UNA direccion de los bloqueos AUTOMATICOS de sweepguard (18/10/2026).

Lo llama el boton «Desbloquear mi IP» del panel de cliente (Cloud Function
`unblock_my_ip`) por SSH, con una clave propia que en /root/.ssh/authorized_keys
solo puede ejecutar este fichero:

    restrict,command="/usr/local/sbin/neuravps-unblock-ip" ssh-ed25519 AAAA... neuravps-unblock-ip@functions

La peticion llega en SSH_ORIGINAL_COMMAND y solo se acepta exactamente
`unblock <ip>`, `status <ip>`, `allow-vm <ip> <vmids> [console]` o
`revoke-vm <vmids>` (abajo), con una direccion IPv4 o IPv6 global. Todo lo
demas se rechaza sin tocar nada.
Para probar a mano: `neuravps-unblock-ip status 203.0.113.7`.

`unblock <ip>` (el boton) hace, y nada mas:
  1. Si la direccion esta en `bf_static` (bloqueo manual) no toca nada y
     contesta `static`: eso lo decide una persona.
  2. Si esta en `bf_auto`, la quita, borra sus entradas de `bf_seen` y sus
     conexiones de conntrack, y contesta `unblocked`. Si no esta, `not_blocked`.

Por que tambien `bf_seen`: el detector de diversidad de puertos cuenta los
puertos distintos que esa fuente dejo en `bf_seen` (6 h). Mientras dura el
bloqueo no se anota nada nuevo, pero lo de antes sigue ahi: sin vaciarlo, la
pasada siguiente (<= 5 min) volveria a bloquear a la misma fuente por los
mismos puertos. Las conexiones de conntrack, por lo mismo para los detectores
de flood y hot-port (el bloqueo congela sus conexiones en ESTABLISHED).

Nunca toca `bf_allow`, `bf_static`, las reglas ni la memoria de sesiones.

Dos peticiones mas (22/10/2026), para el desbloqueo AUTOMATICO al entrar en el
panel, que NO quita la IP de `bf_auto`:

  status <ip>
      Solo lectura: si esta en `bf_static` / `bf_auto` y que VMs tiene ya
      abiertas en `cust_allow` (y cuanto les queda).

  allow-vm <ip> <vmid>[,<vmid>...] [console]
      Si la IP esta en `bf_auto` (y no en `bf_static`), mete en `cust_allow`
      los pares (ip . puerto) de esas VMs: SMB 1xxxx, RDP 2xxxx y SSH 3xxxx
      (xxxx = vmid), y con `console` tambien el 443 de la base (la consola VNC
      del panel entra por el nginx de la base). Duran ALLOW_SECONDS (48 h) y
      se renuevan si ya estaban. La cadena acepta esos pares antes de la regla
      de `bf_auto` y SOLO mientras la IP este en `bf_auto`: esa IP llega a SUS
      VMs, el resto de la base le sigue cerrado y, fuera del bloqueo, su
      trafico pasa por bf_seen y los limites como el de cualquiera. Borra de
      `bf_seen` lo que esa IP tenia en esos puertos. Si la IP no esta
      bloqueada no hace nada (`not_blocked`). Como mucho MAX_VMIDS VMs por
      llamada; nunca borra entradas de otras IPs (dos clientes pueden
      compartir IP).

  revoke-vm <vmid>[,<vmid>...]
      Borra de `cust_allow`, en las dos familias, TODAS las entradas de los
      puertos de esas VMs, sea cual sea la IP. Lo llama NeuraVPS (trigger
      sobre servers/) cuando una VM se borra, cambia de vmid o de dueño, o
      cuando un vmid se asigna a una VM nueva: el vmid se reutiliza, y una
      entrada vieja dejaria a la IP del dueño anterior llegar a la VM de
      otro. El 443 no se toca (no es de ninguna VM).

IPs de confianza por VPS (24/11/2026)
-------------------------------------
El cliente fija en el panel hasta 10 IPs por VPS (IPv4 /32, IPv6 /128 o /64)
que la base NO filtra hacia los puertos de ESA VM: el set `cust_trust`
(addr . puerto, sin caducidad) tiene una regla `accept` despues de `bf_static`
y antes de `cust_allow`, `bf_auto`, `bf_seen` y los limitadores (ver
deploy_customer_trust.sh), y sweepguard no cuenta esos pares. Para las demas VMs
esa IP sigue las reglas normales. La fuente de verdad en la base es
TRUST_STATE ({vmid: [entradas]}); el set se reescribe ENTERO desde ella en una
sola transaccion (`flush set` + `add element`: atomica, sin hueco).

  trust-check <ip>[/len]
      Solo lectura: si se puede confiar en esa entrada aqui (`accepted`) o no
      (`rejected` con `reason`: static = IPv4 en bf_static; ours = solapa con
      nuestras4/6).
  trust-set <vmid> <entrada>[,<entrada>...] | trust-set <vmid> -
      Fija la lista de UNA VM (`-` = vaciarla). Las entradas rechazadas no se
      aplican y vuelven en `rejected`.
  trust-sync
      Lista COMPLETA por stdin, JSON {"vms": {"<vmid>": [entradas]}} (como
      mucho TRUST_STDIN_MAX bytes). Reemplaza todo. La manda la reconciliacion
      horaria de NeuraVPS.
  trust-restore
      Reaplica TRUST_STATE (al arrancar: neuravps-cust-trust-restore.service).
  trust-status
      Solo lectura: VMs y pares en el estado y en el set.
`revoke-vm` ademas quita la confianza de esas VMs.

Formato de entrada: IPv4 sin prefijo o /32; IPv6 sin prefijo (= /128), /128 o
/64 (los bits de host se descartan). Nada mas ancho. Se rechaza lo no global,
IPv4 mapeada, NAT64 y lo que se solape con nuestras direcciones.

Salida: una linea JSON. Codigo 0 si se atendio (sea cual sea el resultado),
2 si la peticion no es valida, 1 si algo fallo en la base.
"""
import fcntl
import ipaddress
import json
import os
import re
import subprocess
import sys
import syslog
import time

TABLE = "rdpguard"
LOCK = "/run/neuravps-unblock-ip.lock"
# Nada de comillas, espacios de mas ni otros caracteres: el resto se rechaza.
REQUEST_RE = re.compile(r"\Aunblock ([0-9A-Fa-f:.]{2,45})\Z")
STATUS_RE = re.compile(r"\Astatus ([0-9A-Fa-f:.]{2,45})\Z")
ALLOW_RE = re.compile(r"\Aallow-vm ([0-9A-Fa-f:.]{2,45}) ([0-9]{1,4}(?:,[0-9]{1,4}){0,63})( console)?\Z")
REVOKE_RE = re.compile(r"\Arevoke-vm ([0-9]{1,4}(?:,[0-9]{1,4}){0,63})(?: gen=([0-9]{16}))?\Z")
_ENTRY = r"[0-9A-Fa-f:.]{2,45}(?:/[0-9]{1,3})?"
TRUST_CHECK_RE = re.compile(r"\Atrust-check (%s)\Z" % _ENTRY)
TRUST_SET_RE = re.compile(r"\Atrust-set ([0-9]{1,4}) (-|%s(?:,%s){0,9})( closed)?(?: gen=([0-9]{16}))?\Z" % (_ENTRY, _ENTRY))
TRUST_PLAIN = ("trust-sync", "trust-restore", "trust-status")
NFT_TIMEOUT = 20

CUSTOMER_SET = "cust_allow"
# 48 h: el doble del bloqueo (blockSeconds, 24 h). El panel la renueva cada
# 10 min mientras el cliente lo usa ESTANDO bloqueado; una entrada olvidada
# (VM borrada, IP dinamica que cambia de abonado) caduca sola en 2 dias, y
# revoke-vm la quita antes cuando el vmid deja de ser de ese cliente.
ALLOW_SECONDS = 48 * 3600
MAX_VMIDS = 50                  # el cliente con mas servidores tiene 7
VMID_MIN, VMID_MAX = 100, 9999  # los forwards son 1xxxx/2xxxx/3xxxx
FORWARD_BASES = (10000, 20000, 30000)   # SMB, RDP, SSH
CONSOLE_PORT = 443

TRUST_SET = "cust_trust"
# Modo cerrado (24/11/2026, deploy_customer_closed.sh): en los puertos de una VM
# cerrada solo entra su lista (cust_trust, que va antes) y la infraestructura
# (bf_allow, antes todavia); el resto se descarta. CLOSED_SET (ip e ip6):
# proto . puerto de esas VMs. En ip6 ademas su IPv6 publica directa
# (CLOSED_PUB6) y los pares (origen . esa IPv6) de su lista (TRUST_PUB6).
CLOSED_SET = "cust_closed"
CLOSED_PUB6 = "cust_closed_pub6"
TRUST_PUB6 = "cust_trust_pub6"
IPV6_POLICY_STATE = "/var/lib/base-nat/ipv6-policy.json"
TRUST_STATE = "/var/lib/neuravps-sweepguard/cust_trust.json"
TRUST_MAX_PER_VM = 10
TRUST_MAX_VMS = 5000            # ~1.900 VMs en la flota
TRUST_STDIN_MAX = 1024 * 1024
TRUST_V6_PREFIXES = (64, 128)
NAT64_NETS = (ipaddress.ip_network("64:ff9b::/96"), ipaddress.ip_network("64:ff9b:1::/48"))
GUARDED = {"ip": "nuestras4", "ip6": "nuestras6"}


class BadRequest(ValueError):
    pass


def _ip(raw):
    try:
        ip = ipaddress.ip_address(raw)
    except ValueError:
        raise BadRequest("not an IP address")
    if ip.version == 6 and ip.ipv4_mapped is not None:
        ip = ip.ipv4_mapped
    if not ip.is_global:
        raise BadRequest("not a global address")
    return ip


def _vmids(raw):
    out = []
    for tok in raw.split(","):
        if tok != str(int(tok)):             # sin ceros a la izquierda
            raise BadRequest("bad vmid")
        v = int(tok)
        if not VMID_MIN <= v <= VMID_MAX:
            raise BadRequest("vmid out of range")
        if v not in out:
            out.append(v)
    if len(out) > MAX_VMIDS:
        raise BadRequest(f"more than {MAX_VMIDS} vmids")
    return sorted(out)


def parse_request(raw):
    """`unblock <ip>` -> ipaddress normalizado. Lanza BadRequest."""
    m = REQUEST_RE.match(raw or "")
    if not m:
        raise BadRequest("expected: unblock <ip>")
    return _ip(m.group(1))


def _gen_arg(raw, phase):
    """gen=<rev> de la orden; sin el (a mano, o NeuraVPS anterior), AHORA en la
    fase de la orden."""
    if raw is None:
        return now_gen(phase)
    g = int(raw)
    if not gen_ok(g):
        raise BadRequest("bad gen (future or out of range)")
    return g


def parse_command(raw):
    """Peticion -> (orden, ip, vmids, consola). Lanza BadRequest.
    unblock <ip> | status <ip> | allow-vm <ip> <vmid>[,<vmid>...] [console]
    | revoke-vm <vmid>[,<vmid>...]   (en revoke-vm, ip = None)"""
    raw = raw or ""
    m = REQUEST_RE.match(raw)
    if m:
        return "unblock", _ip(m.group(1)), [], False
    m = STATUS_RE.match(raw)
    if m:
        return "status", _ip(m.group(1)), [], False
    m = ALLOW_RE.match(raw)
    if m:
        return "allow-vm", _ip(m.group(1)), _vmids(m.group(2)), bool(m.group(3))
    m = REVOKE_RE.match(raw)
    if m:
        return "revoke-vm", None, _vmids(m.group(1)), _gen_arg(m.group(2), GEN_REVOKE)
    m = TRUST_CHECK_RE.match(raw)
    if m:
        return "trust-check", trust_entry(m.group(1)), [], False
    m = TRUST_SET_RE.match(raw)
    if m:
        vmid = _vmids(m.group(1))
        ents = [] if m.group(2) == "-" else [trust_entry(t) for t in m.group(2).split(",")]
        return "trust-set", ents, vmid, (_gen_arg(m.group(4), GEN_SET), bool(m.group(3)))
    if raw in TRUST_PLAIN:
        return raw, None, [], False
    raise BadRequest("expected: unblock <ip> | status <ip> | allow-vm <ip> <vmid>[,...] [console]"
                     " | revoke-vm <vmid>[,...] | trust-check <ip>[/len] | trust-set <vmid> <ip>[,...]|-"
                     " | trust-sync | trust-restore | trust-status")


def vm_ports(vmids, console=False):
    ports = [b + v for v in vmids for b in FORWARD_BASES]
    return sorted(ports + ([CONSOLE_PORT] if console else []))


def family_of(ip):
    return "ip" if ip.version == 4 else "ip6"


def run(cmd, stdin=None):
    return subprocess.run(cmd, input=stdin, capture_output=True, text=True,
                          timeout=NFT_TIMEOUT)


def set_presence(fam, name):
    """True / False si el set existe o no; RuntimeError si nft no contesta o da
    otro error (no se confunde «no está» con «no se pudo mirar»)."""
    r = run(["nft", "-t", "list", "set", fam, TABLE, name])
    if r.returncode == 0:
        return True
    if "No such file or directory" in r.stderr:
        return False
    raise RuntimeError(f"nft list set {fam} {name}: {' '.join(r.stderr.split())[:160]}")


def set_exists(fam, name):
    # -t: sin elementos (bf_static tiene ~14.000 en v4)
    return run(["nft", "-t", "list", "set", fam, TABLE, name]).returncode == 0


def in_set(fam, name, addr):
    """True/False si la direccion esta en el set. Solo se llama con sets que
    existen: un error que no sea «no esta» se propaga."""
    r = run(["nft", "get", "element", fam, TABLE, name, "{ %s }" % addr])
    if r.returncode == 0:
        return True
    if "No such file or directory" in r.stderr:
        return False
    raise RuntimeError(f"nft get element {name}: {' '.join(r.stderr.split())[:160]}")


def seen_ports(fam, addr, name="bf_seen"):
    """Puertos que `bf_seen` (o `cust_allow`) tiene anotados para esta fuente."""
    return [p for p, _ in pair_ports(fam, addr, name)]


def pair_ports(fam, addr, name):
    """[(puerto, segundos que le quedan o None)] de un set (addr . puerto)."""
    r = run(["nft", "-j", "list", "set", fam, TABLE, name])
    if r.returncode != 0:
        return []
    ports = []
    for obj in json.loads(r.stdout).get("nftables", []):
        for e in (obj.get("set") or {}).get("elem", []) or []:
            val = e.get("elem", {}).get("val") if isinstance(e, dict) else None
            concat = val.get("concat") if isinstance(val, dict) else None
            if not concat or len(concat) != 2:
                continue
            try:
                same = ipaddress.ip_address(str(concat[0])) == addr
            except ValueError:
                continue
            if same and isinstance(concat[1], int):
                exp = e["elem"].get("expires")
                ports.append((concat[1], exp if isinstance(exp, int) else None))
    return ports


def forget_seen(fam, addr, only=None):
    """Borra las entradas (addr . puerto) de bf_seen (solo las de `only` si se
    da). Devuelve cuantas."""
    ports = seen_ports(fam, addr)
    if only is not None:
        ports = [p for p in ports if p in only]
    if not ports:
        return 0
    batch = "".join(f"delete element {fam} {TABLE} bf_seen {{ {addr} . {p} }}\n"
                    for p in ports)
    if run(["nft", "-f", "-"], stdin=batch).returncode == 0:
        return len(ports)
    # Alguna caduco entre la lectura y el borrado: la transaccion entera falla.
    done = 0
    for p in ports:
        if run(["nft", "delete", "element", fam, TABLE, "bf_seen",
                "{ %s . %d }" % (addr, p)]).returncode == 0:
            done += 1
    return done


def flush_conntrack(fam, addr):
    r = run(["conntrack", "-D", "-f", "ipv4" if fam == "ip" else "ipv6",
             "-s", str(addr)])
    m = re.search(r"(\d+) flow entr", r.stderr + r.stdout)
    return int(m.group(1)) if m else 0


def unblock(ip):
    fam = family_of(ip)
    addr = str(ip)
    out = {"ip": addr, "family": fam}
    if set_exists(fam, "bf_static") and in_set(fam, "bf_static", addr):
        out["result"] = "static"
        return out
    if not in_set(fam, "bf_auto", addr):
        out["result"] = "not_blocked"
        return out
    r = run(["nft", "delete", "element", fam, TABLE, "bf_auto", "{ %s }" % addr])
    if r.returncode != 0 and in_set(fam, "bf_auto", addr):
        raise RuntimeError(f"nft delete bf_auto: {' '.join(r.stderr.split())[:160]}")
    out["result"] = "unblocked"
    out["seenForgotten"] = forget_seen(fam, ip)
    out["conntrackDeleted"] = flush_conntrack(fam, addr)
    return out


def status(ip):
    """Solo lectura: bloqueos y VMs ya abiertas en cust_allow para esta IP."""
    fam = family_of(ip)
    addr = str(ip)
    out = {"ip": addr, "family": fam, "result": "status",
           "static": bool(set_exists(fam, "bf_static") and in_set(fam, "bf_static", addr)),
           "blocked": in_set(fam, "bf_auto", addr),
           "customerSet": set_exists(fam, CUSTOMER_SET)}
    if out["customerSet"]:
        left = dict(pair_ports(fam, ip, CUSTOMER_SET))
        vms = {}
        for p, exp in left.items():
            if p == CONSOLE_PORT or not 10000 <= p <= 39999:
                continue
            v = p % 10000
            trio = [left.get(b + v) for b in FORWARD_BASES]
            if all(isinstance(x, int) for x in trio):
                vms[str(v)] = min(trio)          # la VM esta abierta si lo estan sus 3 puertos
        out["allowedVmids"] = vms
        if isinstance(left.get(CONSOLE_PORT), int):
            out["consoleExpires"] = left[CONSOLE_PORT]
    return out


def allow_vm(ip, vmids, console):
    """Abre a esta IP solo los puertos de esas VMs (ver docstring del modulo)."""
    fam = family_of(ip)
    addr = str(ip)
    out = {"ip": addr, "family": fam, "vmids": vmids}
    if set_exists(fam, "bf_static") and in_set(fam, "bf_static", addr):
        out["result"] = "static"
        return out
    if not set_exists(fam, CUSTOMER_SET):
        raise RuntimeError(f"set {fam} {TABLE} {CUSTOMER_SET} missing (deploy_customer_allow.sh)")
    if not in_set(fam, "bf_auto", addr):
        out["result"] = "not_blocked"
        return out
    ports = vm_ports(vmids, console)
    present = set(seen_ports(fam, ip, CUSTOMER_SET)) & set(ports)
    # borrar y volver a meter en la MISMA transaccion renueva el plazo sin hueco
    batch = "".join(f"delete element {fam} {TABLE} {CUSTOMER_SET} {{ {addr} . {p} }}\n"
                    for p in sorted(present))
    batch += "".join(f"add element {fam} {TABLE} {CUSTOMER_SET} {{ {addr} . {p} timeout {ALLOW_SECONDS}s }}\n"
                     for p in ports)
    if run(["nft", "-f", "-"], stdin=batch).returncode != 0:
        # alguna caduco entre la lectura y el borrado: una a una
        failed = 0
        for p in ports:
            run(["nft", "delete", "element", fam, TABLE, CUSTOMER_SET, "{ %s . %d }" % (addr, p)])
            if run(["nft", "add", "element", fam, TABLE, CUSTOMER_SET,
                    "{ %s . %d timeout %ds }" % (addr, p, ALLOW_SECONDS)]).returncode != 0:
                failed += 1
        if failed:
            raise RuntimeError(f"nft add {CUSTOMER_SET}: {failed} of {len(ports)} failed")
    out["result"] = "allowed"
    out["ports"] = len(ports)
    out["renewed"] = len(present)
    out["console"] = console
    out["seenForgotten"] = forget_seen(fam, ip, set(ports))
    return out


def set_pairs(fam, name):
    """[(addr, puerto)] de todo un set (addr . puerto), con la addr tal cual la
    da nft (forma comprimida)."""
    r = run(["nft", "-j", "list", "set", fam, TABLE, name])
    if r.returncode != 0:
        return []
    out = []
    for obj in json.loads(r.stdout).get("nftables", []):
        for e in (obj.get("set") or {}).get("elem", []) or []:
            val = e.get("elem", {}).get("val") if isinstance(e, dict) else None
            concat = val.get("concat") if isinstance(val, dict) else None
            if concat and len(concat) == 2 and isinstance(concat[0], str) and isinstance(concat[1], int):
                out.append((concat[0], concat[1]))
    return out


def revoke_vm(vmids, gen=None):
    """Quita de cust_allow todas las entradas de los puertos de esas VMs, de
    cualquier IP y en las dos familias."""
    gen = now_gen(GEN_REVOKE) if gen is None else gen
    ports = set(vm_ports(vmids))
    out = {"vmids": vmids, "removed": 0}
    sets = 0
    for fam in ("ip", "ip6"):
        if not set_exists(fam, CUSTOMER_SET):
            continue
        sets += 1
        doomed = [(a, p) for a, p in set_pairs(fam, CUSTOMER_SET) if p in ports]
        if not doomed:
            continue
        batch = "".join(f"delete element {fam} {TABLE} {CUSTOMER_SET} {{ {a} . {p} }}\n"
                        for a, p in doomed)
        if run(["nft", "-f", "-"], stdin=batch).returncode == 0:
            out["removed"] += len(doomed)
            continue
        # alguna caduco entre la lectura y el borrado: una a una
        for a, p in doomed:
            if run(["nft", "delete", "element", fam, TABLE, CUSTOMER_SET,
                    "{ %s . %d }" % (a, p)]).returncode == 0:
                out["removed"] += 1
        left = [x for x in set_pairs(fam, CUSTOMER_SET) if x[1] in ports]
        if left:
            raise RuntimeError(f"{len(left)} entries of {fam} {CUSTOMER_SET} still there")
    out["result"] = "revoked" if sets else "no_set"
    out["trustRemoved"] = revoke_trust(vmids, gen)
    return out


# --- IPs de confianza por VPS (24/11/2026) ------------------------------------
# Todo lo que entra (orden SSH, stdin, fichero de estado) pasa por trust_entry,
# que exige la gramatica ASCII de _ENTRY ANTES de llamar a ipaddress, y el
# texto que va a nft se genera desde la direccion numerica (entry_text). Ante
# cualquier duda se falla cerrado: sin leer nuestras4/6, con un estado roto o
# una carga con una sola entrada mala, no se toca el set.

_ENTRY_FULL = re.compile(r"\A%s\Z" % _ENTRY)
_VMID_KEY = re.compile(r"\A[1-9][0-9]{2,3}\Z")
TRUST_READ_SECONDS = 15
# Revisiones: microsegundos epoch * 4 + fase. Las pone NeuraVPS con la hora de
# Firestore (lectura del servidor en la transaccion, o la hora del evento).
# Cada VM recuerda la de su ultima orden y solo acepta otra POSTERIOR
# (estricto): una alta atrasada no deshace una revocacion ni una foto vieja una
# baja. La fase ordena lo que cae en el mismo microsegundo: la foto pierde ante
# todo, la revocacion gana al alta, y la reaplicacion tras una revocacion del
# mismo evento va despues de ella.
GEN_SYNC, GEN_SET, GEN_REVOKE, GEN_REAPPLY = 0, 1, 2, 3
TRUST_GEN_SKEW = 10 * 60 * 1_000_000 * 4
# Elementos (proto, base de puerto) por entrada: TCP a SMB/RDP/SSH, UDP solo a
# RDP (el transporte UDP de RDP; la base solo reenvia UDP en 2xxxx).
TRUST_PROTOS = (("tcp", 10000), ("tcp", 20000), ("udp", 20000), ("tcp", 30000))


def trust_entry(raw):
    """Texto -> red normalizada (IPv4Network /32 o IPv6Network /64 o /128).
    Lanza BadRequest. Ver docstring del modulo."""
    if not isinstance(raw, str) or not _ENTRY_FULL.match(raw):
        raise BadRequest("bad entry syntax")
    addr, slash, plen = raw.partition("/")
    try:
        ip = ipaddress.ip_address(addr)
    except ValueError:
        raise BadRequest("not an IP address")
    if ip.version == 6 and ip.ipv4_mapped is not None:
        raise BadRequest("IPv4-mapped IPv6: use the IPv4 address")
    if slash:
        if plen != str(int(plen)):
            raise BadRequest("bad prefix")
        plen = int(plen)
    else:
        plen = 32 if ip.version == 4 else 128
    if ip.version == 4 and plen != 32:
        raise BadRequest("IPv4: only single addresses (/32)")
    if ip.version == 6 and plen not in TRUST_V6_PREFIXES:
        raise BadRequest("IPv6: only /128 or /64")
    net = ipaddress.ip_network(f"{ip}/{plen}", strict=False)
    if ip.version == 6 and any(net.overlaps(n) for n in NAT64_NETS):
        raise BadRequest("NAT64 range")
    na = net.network_address
    if (not net.is_global or not na.is_global or net.is_multicast or net.is_reserved
            or na.is_reserved or getattr(na, "is_site_local", False)):
        raise BadRequest("not a global address")
    return net


def entry_text(net):
    """Forma canonica de una entrada, desde la direccion NUMERICA (nunca el
    texto recibido): IPv4 y /128 sin prefijo; /64 con el suyo."""
    cls = ipaddress.IPv4Address if net.version == 4 else ipaddress.IPv6Address
    addr = cls(int(net.network_address)).compressed
    return addr if net.prefixlen == net.max_prefixlen else f"{addr}/{net.prefixlen}"


def guarded_nets(fam):
    """Redes de nuestras4/6. Lanza RuntimeError si no se puede leer el set o
    trae un elemento que no se entiende: sin esta lista no se acepta nada."""
    name = GUARDED[fam]
    r = run(["nft", "-j", "list", "set", fam, TABLE, name])
    if r.returncode != 0:
        raise RuntimeError(f"cannot read {fam} {name}: {' '.join(r.stderr.split())[:120]}")
    found, nets = False, []
    for obj in json.loads(r.stdout).get("nftables", []):
        s = obj.get("set")
        if not s or s.get("name") != name:
            continue
        found = True
        for e in s.get("elem", []) or []:
            if isinstance(e, str):
                nets.append(ipaddress.ip_network(e))
            elif isinstance(e, dict) and "prefix" in e:
                p = e["prefix"]
                nets.append(ipaddress.ip_network(f"{p['addr']}/{p['len']}", strict=False))
            elif isinstance(e, dict) and "range" in e:
                lo, hi = (ipaddress.ip_address(x) for x in e["range"])
                nets.extend(ipaddress.summarize_address_range(lo, hi))
            elif isinstance(e, dict) and "elem" in e and isinstance(e["elem"].get("val"), str):
                nets.append(ipaddress.ip_network(e["elem"]["val"]))
            else:
                raise RuntimeError(f"{fam} {name}: element not understood: {str(e)[:80]}")
    if not found or not nets:
        raise RuntimeError(f"{fam} {name} missing or empty")
    return nets


class TrustChecker:
    """Rechazos que dependen de la base: bf_static (IPv4) y nuestras4/6. Lee
    cada set una sola vez por peticion."""

    def __init__(self):
        self._ours = {}
        self._static = {}

    def reason(self, net):
        fam = "ip" if net.version == 4 else "ip6"
        if fam not in self._ours:
            self._ours[fam] = guarded_nets(fam)
            self._static[fam] = set_exists(fam, "bf_static")
        if any(net.overlaps(n) for n in self._ours[fam]):
            return "ours"
        if self._static[fam] and in_set(fam, "bf_static", entry_text(net).split("/")[0]):
            return "static"
        return None


def clean_list(nets, checker):
    """Lista de UNA VM -> (aceptadas [red], rechazadas {texto: motivo}).
    Sin duplicados, sin /128 cubiertas por un /64 de la misma lista (el set de
    intervalos no admite solapes), y como mucho TRUST_MAX_PER_VM."""
    ok, rejected = [], {}
    for net in sorted(set(nets), key=lambda n: (n.version, n.prefixlen, int(n.network_address))):
        if any(net != o and net.subnet_of(o) for o in ok if o.version == net.version):
            rejected[entry_text(net)] = "covered"
            continue
        why = checker.reason(net)
        if why:
            rejected[entry_text(net)] = why
            continue
        if len(ok) >= TRUST_MAX_PER_VM:
            rejected[entry_text(net)] = "too_many"
            continue
        ok.append(net)
    return ok, rejected


def _no_dup_keys(pairs):
    d = {}
    for k, v in pairs:
        if k in d:
            raise BadRequest(f"duplicate key {str(k)[:12]!r}")
        d[k] = v
    return d


def now_gen(phase):
    """Revision de AHORA en la fase dada (ver GEN_*)."""
    return int(time.time() * 1_000_000) * 4 + phase


def gen_ok(g):
    """Revision valida: entero de 16 cifras y no del futuro (10 min de margen
    de reloj): una revision del futuro bloquearia todo lo que viniera despues."""
    return isinstance(g, int) and not isinstance(g, bool) and 10 ** 15 <= g < 10 ** 16 \
        and g <= now_gen(3) + TRUST_GEN_SKEW


class TrustState:
    """Estado de la base: listas por VM, revision de la ultima orden aplicada
    a cada VM y la de la ultima foto completa (`sync_gen`), que vale de suelo
    para toda VM sin revision propia (una foto dice «sin confianza» para todas
    las que no trae)."""

    def __init__(self, vms=None, gens=None, sync_gen=0, closed=None, cut_pending=None):
        self.vms = vms or {}
        self.gens = gens or {}
        self.sync_gen = sync_gen
        # VMs cerradas cuyas sesiones ajenas aún no se han podido cortar: se
        # reintenta en cada orden hasta lograrlo (ver cut_flows)
        self.cut_pending = set(cut_pending or ())
        # VMs en modo cerrado; solo con lista (una VM sin lista nunca se cierra)
        self.closed = {v for v in (closed or ()) if v in self.vms}

    def last(self, vmid):
        return max(self.gens.get(vmid, 0), self.sync_gen)

    def doc(self):
        # una revision por debajo del suelo ya no aporta nada: se olvida
        keep = {v: g for v, g in self.gens.items() if v in self.vms or g > self.sync_gen}
        return json.dumps({"v": 3, "syncGen": self.sync_gen,
                           "closed": [str(v) for v in sorted(self.closed) if v in self.vms],
                           "cutPending": [str(v) for v in sorted(self.cut_pending) if v in self.closed],
                           "vms": {str(v): [entry_text(n) for n in self.vms[v]] for v in sorted(self.vms)},
                           "gens": {str(v): keep[v] for v in sorted(keep)}}, sort_keys=True)


def parse_trust_doc(raw, what, kind="payload"):
    """JSON -> dict. TODO o nada: una clave o entrada mala rechaza el documento
    entero (BadRequest).
      payload (trust-sync): {"gen": rev, "vms": {"<vmid>": [entradas]}}
      state (TRUST_STATE):  {"v": 3, "syncGen": rev, "vms": {...}, "gens": {"<vmid>": rev}}
    Devuelve {"vms": {vmid: [red]}, "gens": {vmid: rev}, "gen": rev|None, "syncGen": rev}."""
    try:
        doc = json.loads(raw, object_pairs_hook=_no_dup_keys)
    except BadRequest:
        raise
    except ValueError:
        raise BadRequest(f"{what} is not JSON")
    vms = doc.get("vms") if isinstance(doc, dict) else None
    if not isinstance(vms, dict) or len(vms) > TRUST_MAX_VMS:
        raise BadRequest(f"{what}: expected {{\"vms\": {{vmid: [entries]}}}}")

    def vmid_key(k):
        if not isinstance(k, str) or not _VMID_KEY.match(k) or not VMID_MIN <= int(k) <= VMID_MAX:
            raise BadRequest(f"{what}: bad vmid {str(k)[:12]!r}")
        return int(k)

    def rev(g, where, allow_zero=False):
        if allow_zero and g == 0:
            return 0
        if not gen_ok(g):
            raise BadRequest(f"{what}: bad gen {where}")
        return g

    out = {"vms": {}, "gens": {}, "gen": None, "syncGen": 0, "closed": set(), "cutPending": set()}
    for k, ents in vms.items():
        if not isinstance(ents, list) or len(ents) > TRUST_MAX_PER_VM:
            raise BadRequest(f"{what}: vm {k}: expected a list of at most {TRUST_MAX_PER_VM}")
        out["vms"][vmid_key(k)] = [trust_entry(t) for t in ents]
    closed = doc.get("closed", [])
    if not isinstance(closed, list) or len(closed) > TRUST_MAX_VMS:
        raise BadRequest(f"{what}: bad closed")
    for k in closed:
        v = vmid_key(k)
        if v not in out["vms"]:
            raise BadRequest(f"{what}: closed vm {v} without a list")
        out["closed"].add(v)
    if kind == "payload":
        out["gen"] = rev(doc.get("gen"), "of payload")
    else:
        if doc.get("v") != 3:
            raise BadRequest(f"{what}: unknown version {str(doc.get('v'))[:8]!r}")
        out["syncGen"] = rev(doc.get("syncGen", 0), "syncGen", allow_zero=True)
        cp = doc.get("cutPending", [])
        if not isinstance(cp, list) or len(cp) > TRUST_MAX_VMS:
            raise BadRequest(f"{what}: bad cutPending")
        out["cutPending"] = {vmid_key(k) for k in cp}
        gens = doc.get("gens", {})
        if not isinstance(gens, dict) or len(gens) > 4 * TRUST_MAX_VMS:
            raise BadRequest(f"{what}: bad gens")
        for k, g in gens.items():
            out["gens"][vmid_key(k)] = rev(g, f"for {str(k)[:12]!r}")
    return out


def load_trust_state(path=None):
    """TrustState desde TRUST_STATE. Ausente = vacio (base nueva); ilegible o
    con algo invalido = RuntimeError: nunca se reconstruye el set desde un
    fichero roto."""
    path = path or TRUST_STATE
    try:
        with open(path) as fh:
            raw = fh.read()
    except FileNotFoundError:
        return TrustState()
    except OSError as exc:
        raise RuntimeError(f"{path} unreadable ({exc}); not touching {TRUST_SET}")
    try:
        d = parse_trust_doc(raw, path, "state")
    except BadRequest as exc:
        raise RuntimeError(f"{path} invalid ({exc}); not touching {TRUST_SET}")
    return TrustState(d["vms"], d["gens"], d["syncGen"], d["closed"], d["cutPending"])


def trust_elements(vms):
    """{fam: ["addr . proto . puerto", ...]} de todas las listas."""
    out = {"ip": [], "ip6": []}
    for vmid in sorted(vms):
        for net in vms[vmid]:
            fam = "ip" if net.version == 4 else "ip6"
            for proto, base in TRUST_PROTOS:
                out[fam].append(f"{entry_text(net)} . {proto} . {base + vmid}")
    return out


def _write_atomic(path, text):
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        fh.write(text)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, path)
    dfd = os.open(d, os.O_RDONLY)
    try:
        os.fsync(dfd)            # el rename tambien tiene que llegar al disco
    finally:
        os.close(dfd)


def apply_trust(st, path=None):
    """Publica el estado y reescribe `cust_trust` (las dos familias) en UNA
    transaccion. Primero el fichero (si se corta despues, al arrancar manda el
    estado nuevo: una revocacion no se pierde) y luego nft; si nft falla o no
    contesta, se vuelve a escribir el estado anterior y se lanza. TODA orden
    termina aqui, tambien las descartadas por atrasadas: el set vivo queda
    siempre igual que el fichero (repara un intento anterior a medias)."""
    path = path or TRUST_STATE
    for fam in ("ip", "ip6"):
        if not set_presence(fam, TRUST_SET):
            raise RuntimeError(f"set {fam} {TABLE} {TRUST_SET} missing (deploy_customer_trust.sh)")
    elems = trust_elements(st.vms)
    batch = ""
    for fam in ("ip", "ip6"):
        batch += _fill(fam, TRUST_SET, elems[fam])
    closed_sets = [set_presence(fam, CLOSED_SET) for fam in ("ip", "ip6")] + \
        [set_presence("ip6", n) for n in (CLOSED_PUB6, TRUST_PUB6)]
    if any(closed_sets) and not all(closed_sets):
        raise RuntimeError("closed-mode sets only partly present (deploy_customer_closed.sh)")
    if all(closed_sets):
        c = closed_elements(st)
        batch += _fill("ip", CLOSED_SET, c["ports"]) + _fill("ip6", CLOSED_SET, c["ports"])
        batch += _fill("ip6", CLOSED_PUB6, c["pub6"]) + _fill("ip6", TRUST_PUB6, c["trust_pub6"])
    closed_applied = all(closed_sets) or not st.closed
    # sin los sets (base sin desplegar o tras rollback_customer_closed.sh) las VMs
    # «cerradas» quedan ABIERTAS: no se rompe la lista; se dice en closedApplied
    try:
        with open(path) as fh:
            previous = fh.read()
    except FileNotFoundError:
        previous = None
    _write_atomic(path, st.doc())
    try:
        r = run(["nft", "-f", "-"], stdin=batch)
        err = None if r.returncode == 0 else " ".join(r.stderr.split())[:200]
    except Exception as exc:  # noqa: BLE001  (TimeoutExpired incluido)
        err = f"{type(exc).__name__}: {exc}"[:200]
    if err is not None:
        if previous is None:
            os.unlink(path)
        else:
            _write_atomic(path, previous)
        raise RuntimeError(f"nft {TRUST_SET}: {err}")
    return {"vms": len(st.vms), "pairs": sum(len(v) for v in elems.values()),
            "closedVms": len(st.closed), "closedApplied": closed_applied}


def _fill(fam, name, lst):
    out = f"flush set {fam} {TABLE} {name}\n"
    for i in range(0, len(lst), 500):
        out += f"add element {fam} {TABLE} {name} {{ {', '.join(lst[i:i + 500])} }}\n"
    return out


def public6_prefix():
    """/64 de las IPv6 publicas directas de esta base (politica IPv6 directa:
    publica = main/64 + vmid). None si la politica no esta en esta base (no hay
    IPv6 directa que cerrar). Fichero presente pero ilegible = RuntimeError."""
    try:
        with open(IPV6_POLICY_STATE) as fh:
            d = json.load(fh)
    except FileNotFoundError:
        return None
    except Exception as exc:
        raise RuntimeError(f"{IPV6_POLICY_STATE} unreadable ({exc}): cannot close direct IPv6")
    main = d.get("main") if isinstance(d, dict) else None
    try:
        return ipaddress.IPv6Network(f"{ipaddress.IPv6Address(main)}/64", strict=False)
    except (ValueError, TypeError):
        raise RuntimeError(f"{IPV6_POLICY_STATE}: bad main {str(main)[:40]!r}")


IDENT6 = ipaddress.IPv6Network("2a01:4f9:c01f:e::/64")   # identidad IPv6 de cada VM (base_ipv6_policy.IDENT)


def pub6_of(prefix, vmid):
    return ipaddress.IPv6Address(int(prefix.network_address) + vmid).compressed


def ident6_of(vmid):
    return ipaddress.IPv6Address(int(IDENT6.network_address) + vmid).compressed


def closed_elements(st):
    """Elementos de los sets del modo cerrado para las VMs cerradas.
    `pub6` son PARES (IPv6 directa . identidad de la VM): la regla solo decide
    si el DNAT llevó de verdad esa dirección a ESA VM (`ct reply ip6 saddr`),
    no si la dirección se calculó para un vmid sin IPv6 directa y el tráfico
    acabó en otra VM por un forward."""
    ports, pub6, tpub6 = [], [], []
    prefix = public6_prefix() if st.closed else None
    for vmid in sorted(st.closed):
        ports += [f"{proto} . {base + vmid}" for proto, base in TRUST_PROTOS]
        if prefix is not None:
            addr = pub6_of(prefix, vmid)
            pub6.append(f"{addr} . {ident6_of(vmid)}")
            tpub6 += [f"{entry_text(n)} . {addr}" for n in st.vms.get(vmid, []) if n.version == 6]
    return {"ports": ports, "pub6": pub6, "trust_pub6": tpub6}


_CT_TUPLES = re.compile(r"src=(\S+) dst=(\S+) sport=(\d+) dport=(\d+).*?src=(\S+) dst=(\S+) sport=(\d+) dport=(\d+)")
# el DNAT de ip6 nat traduce el puerto del forward (como `ct reply proto-src` en la regla)
FWD6_PORT = {10000: "445", 20000: "3389", 30000: "22"}


def _allowed_nets(fam):
    """Redes de bf_allow de esa familia (infraestructura: no se le cortan sesiones)."""
    nets = []
    r = run(["nft", "-j", "list", "set", fam, TABLE, "bf_allow"])
    if r.returncode != 0:
        raise RuntimeError(f"cannot read {fam} bf_allow")
    try:
        objs = json.loads(r.stdout or '{"nftables": []}').get("nftables", [])
    except ValueError:
        raise RuntimeError(f"{fam} bf_allow unparseable")
    for obj in objs:
        for e in (obj.get("set") or {}).get("elem", []) or []:
            try:
                if isinstance(e, str):
                    nets.append(ipaddress.ip_network(e))
                elif isinstance(e, dict) and "prefix" in e:
                    nets.append(ipaddress.ip_network(f"{e['prefix']['addr']}/{e['prefix']['len']}", strict=False))
                elif isinstance(e, dict) and "range" in e:
                    lo, hi = (ipaddress.ip_address(x) for x in e["range"])
                    nets.extend(ipaddress.summarize_address_range(lo, hi))
            except (ValueError, KeyError, TypeError):
                continue
    return nets


def _ct_list(args):
    """Entradas de conntrack que casan: [(orig_src, orig_dst, orig_sport, orig_dport,
    reply_src, reply_sport)]. Lanza si conntrack falla."""
    r = run(["conntrack", "-L"] + args)
    if r.returncode != 0:
        raise RuntimeError(f"conntrack -L {' '.join(args)}: rc={r.returncode} {(r.stderr or '')[:120]}")
    out = []
    for ln in (r.stdout or "").splitlines():
        m = _CT_TUPLES.search(ln)
        if m:
            out.append((m.group(1), m.group(2), m.group(3), m.group(4), m.group(5), m.group(7)))
    return out


def _vm_flows(vmid, fam, prefix):
    """Conexiones DNATeadas HACIA esa VM, con el mismo criterio que las reglas:
    v4: forward con DNAT (la respuesta no viene del destino original); v6:
    forward con el puerto traducido, o IPv6 directa (directa → identidad de la VM).
    [(proto, orig_src, orig_dst, orig_sport, orig_dport)]."""
    cf = "ipv4" if fam == "ip" else "ipv6"
    flows = []
    for proto, base in TRUST_PROTOS:
        port = str(base + vmid)
        for osrc, odst, osport, odport, rsrc, rsport in _ct_list(["-f", cf, "-p", proto, "--orig-port-dst", port]):
            if odport != port or ipaddress.ip_address(rsrc) == ipaddress.ip_address(odst):
                continue                      # sin DNAT: no es un forward (p. ej. salida de un invitado)
            if fam == "ip6" and rsport != FWD6_PORT[base]:
                continue                      # puerto sin traducir: directa de otra VM, no este forward
            flows.append((proto, osrc, odst, osport, odport))
    if fam == "ip6" and prefix is not None:
        pub = pub6_of(prefix, vmid)
        ident = ipaddress.ip_address(ident6_of(vmid))
        for proto in ("tcp", "udp"):
            for osrc, odst, osport, odport, rsrc, rsport in _ct_list(["-f", cf, "-p", proto, "-d", pub]):
                if ipaddress.ip_address(rsrc) == ident:
                    flows.append((proto, osrc, odst, osport, odport))
    return flows


def cut_flows(before, st):
    """Corta las sesiones YA establecidas (y con ello su entrada en la flowtable,
    que se salta las reglas) hacia las VMs cerradas cuya política cambió (se
    cierran, o pierden una IP de la lista) y hacia las que tenían un corte
    pendiente, salvo las de su lista, bf_allow y Jool (64:ff9b:1::/96: su lado
    IPv4 se corta en la tabla ip). Borra por la tupla original COMPLETA.
    Las VMs en las que algo falla quedan en `st.cut_pending` (se guarda) y se
    reintentan en la orden siguiente. Devuelve {"flowsCut", "flowsCutOk"}."""
    changed = {v for v in st.closed
               if before.get(v) != (True, frozenset(entry_text(n) for n in st.vms.get(v, [])))}
    todo = sorted((changed | st.cut_pending) & st.closed)
    if not todo:
        st.cut_pending = set()
        return {"flowsCut": 0, "flowsCutOk": True}
    cut, failed = 0, set()
    try:
        allow = {"ip": _allowed_nets("ip"), "ip6": _allowed_nets("ip6")}
        prefix = public6_prefix()
    except Exception:  # noqa: BLE001
        st.cut_pending = set(todo)
        return {"flowsCut": 0, "flowsCutOk": False}
    jool = ipaddress.ip_network("64:ff9b:1::/96")
    for vmid in todo:
        nets = st.vms.get(vmid, [])
        try:
            for fam in ("ip", "ip6"):
                for proto, osrc, odst, osport, odport in _vm_flows(vmid, fam, prefix):
                    ip = ipaddress.ip_address(osrc)
                    if (ip.version == 6 and ip in jool) or \
                            any(ip.version == n.version and ip in n for n in nets + allow[fam]):
                        continue
                    r = run(["conntrack", "-D", "-f", "ipv4" if fam == "ip" else "ipv6", "-p", proto,
                             "-s", osrc, "-d", odst, "--sport", osport, "--dport", odport])
                    msg = (r.stderr or "") + (r.stdout or "")
                    m = re.search(r"(\d+) flow entr", msg)
                    if r.returncode == 0:
                        cut += int(m.group(1)) if m else 1
                    elif not (m and m.group(1) == "0"):     # «0 entries»: ya no estaba; otro error, pendiente
                        raise RuntimeError(f"conntrack -D rc={r.returncode}")
        except Exception:  # noqa: BLE001
            failed.add(vmid)
    st.cut_pending = failed
    return {"flowsCut": cut, "flowsCutOk": not failed}


def _mark_cut_pending(before, st):
    """Antes de publicar la política: las VMs que quedan cerradas y cuya
    política cambió entran en cut_pending EN EL MISMO estado que se guarda. Si
    el proceso se corta antes de cortar sus sesiones, la siguiente orden (o
    trust-restore al arrancar) lo reintenta; solo cut_flows las quita al
    lograrlo."""
    st.cut_pending |= {v for v in st.closed
                       if before.get(v) != (True, frozenset(entry_text(n) for n in st.vms.get(v, [])))}


def _cut_and_save(before, st, applied):
    """cut_flows tras aplicar (solo si el cierre se aplicó en esta base) y, si
    cambió la lista de cortes pendientes, se guarda en el estado (sin tocar nft)."""
    if not applied.get("closedApplied"):
        return {}
    prev = set(st.cut_pending)
    res = cut_flows(before, st)
    if st.cut_pending != prev:
        _write_atomic(TRUST_STATE, st.doc())
    return res


def _snapshot(st):
    return {v: (v in st.closed, frozenset(entry_text(n) for n in l)) for v, l in st.vms.items()}


def trust_check(net):
    why = TrustChecker().reason(net)
    return {"entry": entry_text(net), "result": "rejected" if why else "accepted",
            **({"reason": why} if why else {})}


def trust_set(vmid, nets, gen, closed=False):
    """Fija la lista de UNA VM (y su modo cerrado) si `gen` es POSTERIOR
    (estricto) a la ultima orden de esa VM o a la ultima foto. Si no, `stale` y
    nada cambia. Cerrado solo con al menos una entrada aceptada: si todas se
    rechazan, la VM queda ABIERTA (reglas normales) y se dice en
    `closedRefused`; NeuraVPS ya no deja cerrar sin lista."""
    st = load_trust_state()
    if gen <= st.last(vmid):
        out = {"result": "stale", "vmid": vmid, "gen": gen, "current": st.last(vmid)}
        out.update(apply_trust(st))
        out.update(_cut_and_save(_snapshot(st), st, out))     # reintenta cortes pendientes
        return out
    before = _snapshot(st)
    ok, rejected = clean_list(nets, TrustChecker())
    if ok:
        st.vms[vmid] = ok
    else:
        st.vms.pop(vmid, None)
    if closed and ok:
        st.closed.add(vmid)
    else:
        st.closed.discard(vmid)
    st.gens[vmid] = gen
    out = {"result": "set", "vmid": vmid, "entries": [entry_text(n) for n in ok],
           "rejected": rejected, "gen": gen, "closed": vmid in st.closed}
    if closed and not ok:
        out["closedRefused"] = "no_entries"
    _mark_cut_pending(before, st)
    out.update(apply_trust(st))
    out.update(_cut_and_save(before, st, out))
    return out


def read_sync_payload(stream=None, seconds=TRUST_READ_SECONDS):
    """Lee la carga de trust-sync (BYTES, con plazo) ANTES de tomar el cerrojo:
    una conexion que no cierra stdin no puede parar la base."""
    import select
    fd = (stream or sys.stdin.buffer).fileno()
    buf, deadline = b"", time.monotonic() + seconds
    while True:
        left = deadline - time.monotonic()
        if left <= 0:
            raise BadRequest("payload read timed out")
        ready, _, _ = select.select([fd], [], [], left)
        if not ready:
            continue
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        buf += chunk
        if len(buf) > TRUST_STDIN_MAX:
            raise BadRequest(f"payload over {TRUST_STDIN_MAX} bytes")
    try:
        text = buf.decode("ascii")
    except UnicodeDecodeError:
        raise BadRequest("payload is not ASCII JSON")
    return parse_trust_doc(text, "payload", "payload")


def trust_sync(payload):
    """Foto completa de NeuraVPS con revision `gen` (anterior a cuando se
    leyo). Se aplica a cada VM cuya ultima orden sea ANTERIOR a la foto; las que
    recibieron despues otra orden se quedan como estan. La foto pasa a ser el
    suelo de todas las VMs que no trae."""
    gen, wanted = payload["gen"], payload["vms"]
    # Sin el estado no se conoce el suelo ni las revisiones: una foto atrasada
    # podria deshacer una revocacion posterior. Se falla (NeuraVPS reintenta);
    # un fichero corrupto se aparta A MANO (README) y entonces la foto entra.
    st = load_trust_state()
    if gen <= st.sync_gen:
        out = {"result": "synced", "gen": gen, "staleSnapshot": True,
               "closedMissing": sorted(v for v in payload.get("closed", ()) if v not in st.closed)[:500],
               "closedMissingTruncated": len([v for v in payload.get("closed", ()) if v not in st.closed]) > 500,
               "rejected": {},
               "rejectedCount": 0, "staleVms": [], "changedVms": []}
        out.update(apply_trust(st))
        out.update(_cut_and_save(_snapshot(st), st, out))
        return out
    snap_before = _snapshot(st)
    before = {v: [entry_text(n) for n in l] + (["closed"] if v in st.closed else [])
              for v, l in st.vms.items()}
    checker = TrustChecker()
    rejected, stale = {}, []
    for vmid in sorted(set(st.vms) | set(wanted) | set(st.gens)):
        if st.gens.get(vmid, 0) >= gen:
            stale.append(vmid)
            continue
        ok, rej = clean_list(wanted.get(vmid, []), checker)
        if ok:
            st.vms[vmid] = ok
        else:
            st.vms.pop(vmid, None)
        if ok and vmid in payload.get("closed", ()):
            st.closed.add(vmid)
        else:
            st.closed.discard(vmid)
        st.gens.pop(vmid, None)           # su revision pasa a ser la de la foto (suelo)
        rejected.update({f"{vmid}:{k}": v for k, v in rej.items()})
    st.sync_gen = gen
    # cierres pedidos que esta base NO aplica (lista rechazada entera aquí, u
    # orden más nueva): NeuraVPS los marca pendientes en esos VPS
    closed_missing = sorted(v for v in payload.get("closed", ()) if v not in st.closed)
    closed_missing_truncated = len(closed_missing) > 500
    after = {v: [entry_text(n) for n in l] + (["closed"] if v in st.closed else [])
              for v, l in st.vms.items()}
    out = {"result": "synced", "gen": gen, "closedMissing": closed_missing[:500],
           "closedMissingTruncated": closed_missing_truncated,
           "rejected": dict(list(rejected.items())[:50]),
           "rejectedCount": len(rejected), "staleVms": stale[:100],
           "changedVms": sorted(v for v in set(before) | set(after)
                                if before.get(v) != after.get(v))[:100]}
    _mark_cut_pending(snap_before, st)
    out.update(apply_trust(st))
    out.update(_cut_and_save(snap_before, st, out))
    return out


def trust_restore():
    st = load_trust_state()
    out = {"result": "restored"}
    out.update(apply_trust(st))
    out.update(_cut_and_save(_snapshot(st), st, out))
    return out


def trust_status():
    st = load_trust_state()
    live = {}
    for fam in ("ip", "ip6"):
        if set_exists(fam, TRUST_SET):
            r = run(["nft", "-j", "list", "set", fam, TABLE, TRUST_SET])
            n = 0
            for obj in json.loads(r.stdout or '{"nftables": []}').get("nftables", []):
                n += len((obj.get("set") or {}).get("elem", []) or [])
            live[fam] = n
    want = trust_elements(st.vms)
    return {"result": "status", "vms": len(st.vms), "gens": len(st.gens), "syncGen": st.sync_gen,
            "closed": sorted(st.closed),
            "statePairs": {f: len(v) for f, v in want.items()},
            "setPairs": live, "trustSet": len(live) == 2}


def revoke_trust(vmids, gen):
    """Revocacion con revision `gen` (fase GEN_REVOKE: gana a un alta de la
    misma hora). Por VM: solo si `gen` es posterior (estricto) a su ultima
    orden; una revocacion atrasada no borra la lista que un dueño nuevo guardo
    despues. El set se reescribe SIEMPRE (repara un intento anterior a medias).
    Sin set (base sin desplegar) no hace nada. Devuelve cuantas VMs perdieron
    la confianza."""
    present = [set_presence(fam, TRUST_SET) for fam in ("ip", "ip6")]
    if not any(present):
        return None               # confirmado: base sin desplegar (no hay nada que quitar)
    if not all(present):
        raise RuntimeError(f"{TRUST_SET} only in one family: not revoking half; fix the base")
    st = load_trust_state()
    gone = 0
    for v in vmids:
        if gen <= st.last(v):
            continue
        if st.vms.pop(v, None) is not None:
            gone += 1
        st.closed.discard(v)
        st.gens[v] = gen
    apply_trust(st)
    return gone


def main(argv):
    raw = os.environ.get("SSH_ORIGINAL_COMMAND")
    if raw is None:                      # a mano: neuravps-unblock-ip status <ip>
        raw = " ".join(argv[1:])
    via = "ssh" if "SSH_ORIGINAL_COMMAND" in os.environ else "local"
    syslog.openlog("neuravps-unblock-ip")
    try:
        verb, ip, vmids, console = parse_command(raw)
    except BadRequest as exc:
        syslog.syslog(syslog.LOG_WARNING, f"rejected ({via}): {exc}: {raw[:80]!r}")
        print(json.dumps({"ok": False, "error": "bad_request", "detail": str(exc)}))
        return 2
    if verb.startswith("trust-"):
        what = (",".join(str(v) for v in vmids) + " " if vmids else "") + \
            (",".join(entry_text(n) for n in ip) if isinstance(ip, list)
             else entry_text(ip) if ip is not None else "")
    else:
        what = str(ip) if ip is not None else ",".join(str(v) for v in vmids)
    try:
        if verb == "status":                 # solo lectura: sin cerrojo
            out = status(ip)
        elif verb == "trust-check":
            out = trust_check(ip)
        elif verb == "trust-status":
            out = trust_status()
        elif verb.startswith("trust-"):
            wanted = read_sync_payload() if verb == "trust-sync" else None   # fuera del cerrojo
            with open(LOCK, "w") as fh:
                fcntl.flock(fh, fcntl.LOCK_EX)
                if verb == "trust-set":
                    out = trust_set(vmids[0], ip, console[0], console[1])
                elif verb == "trust-sync":
                    out = trust_sync(wanted)
                else:
                    out = trust_restore()
        else:
            with open(LOCK, "w") as fh:
                fcntl.flock(fh, fcntl.LOCK_EX)
                if verb == "unblock":
                    out = unblock(ip)
                elif verb == "allow-vm":
                    out = allow_vm(ip, vmids, console)
                else:
                    out = revoke_vm(vmids, console)
    except BadRequest as exc:                # trust-sync: carga por stdin no valida
        syslog.syslog(syslog.LOG_WARNING, f"rejected {verb} ({via}): {exc}")
        print(json.dumps({"ok": False, "error": "bad_request", "detail": str(exc)}))
        return 2
    except Exception as exc:  # noqa: BLE001
        syslog.syslog(syslog.LOG_ERR, f"{verb} {what} ({via}): error {exc}")
        err = {"ok": False, "error": "internal", "detail": str(exc)[:200]}
        if ip is not None and not isinstance(ip, list):
            err["ip"] = str(ip)
        print(json.dumps(err))
        return 1
    out["ok"] = True
    syslog.syslog(syslog.LOG_INFO if verb in ("status", "trust-check", "trust-status")
                  else syslog.LOG_NOTICE,
                  f"{verb} {what} ({via}): {json.dumps(out, sort_keys=True)}")
    print(json.dumps(out, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
