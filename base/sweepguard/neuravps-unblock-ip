#!/usr/bin/env python3
"""Quita UNA direccion de los bloqueos AUTOMATICOS de sweepguard (18/10/2026).

Lo llama el boton «Desbloquear mi IP» del panel de cliente (Cloud Function
`unblock_my_ip`) por SSH, con una clave propia que en /root/.ssh/authorized_keys
solo puede ejecutar este fichero:

    restrict,command="/usr/local/sbin/neuravps-unblock-ip" ssh-ed25519 AAAA... neuravps-unblock-ip@functions

La peticion llega en SSH_ORIGINAL_COMMAND y solo se acepta exactamente
`unblock <ip>`, `status <ip>` o `allow-vm <ip> <vmids> [console]` (abajo), con
una direccion IPv4 o IPv6 global. Todo lo demas se rechaza sin tocar nada.
Para probar a mano: `neuravps-unblock-ip status 203.0.113.7`.

`unblock <ip>` (el boton) hace, y nada mas:
  1. Si la direccion esta en `bf_static` (bloqueo manual) no toca nada y
     contesta `static`: eso lo decide una persona.
  2. Si esta en `bf_auto`, la quita, borra sus entradas de `bf_seen` y sus
     conexiones de conntrack, y contesta `unblocked`. Si no esta, `not_blocked`.

Por que tambien `bf_seen`: el detector de diversidad de puertos cuenta los
puertos distintos que esa fuente dejo en `bf_seen` (6 h). Mientras dura el
bloqueo no se anota nada nuevo, pero lo de antes sigue ahi: sin vaciarlo, la
pasada siguiente (<= 5 min) volveria a bloquear a la misma fuente por los
mismos puertos. Las conexiones de conntrack, por lo mismo para los detectores
de flood y hot-port (el bloqueo congela sus conexiones en ESTABLISHED).

Nunca toca `bf_allow`, `bf_static`, las reglas ni la memoria de sesiones.

Dos peticiones mas (22/10/2026), para el desbloqueo AUTOMATICO al entrar en el
panel, que NO quita la IP de `bf_auto`:

  status <ip>
      Solo lectura: si esta en `bf_static` / `bf_auto` y que VMs tiene ya
      abiertas en `cust_allow` (y cuanto les queda).

  allow-vm <ip> <vmid>[,<vmid>...] [console]
      Si la IP esta en `bf_auto` (y no en `bf_static`), mete en `cust_allow`
      los pares (ip . puerto) de esas VMs: SMB 1xxxx, RDP 2xxxx y SSH 3xxxx
      (xxxx = vmid), y con `console` tambien el 443 de la base (la consola VNC
      del panel entra por el nginx de la base). Duran ALLOW_SECONDS y se
      renuevan si ya estaban. La cadena acepta esos pares antes de la regla
      de `bf_auto`: esa IP llega a SUS VMs y el resto de la base le sigue
      cerrado. Borra de `bf_seen` lo que esa IP tenia en esos puertos. Si la
      IP no esta bloqueada no hace nada (`not_blocked`). Como mucho
      MAX_VMIDS VMs por llamada; nunca borra entradas de `cust_allow` (dos
      clientes pueden compartir IP).

Salida: una linea JSON. Codigo 0 si se atendio (sea cual sea el resultado),
2 si la peticion no es valida, 1 si algo fallo en la base.
"""
import fcntl
import ipaddress
import json
import os
import re
import subprocess
import sys
import syslog

TABLE = "rdpguard"
LOCK = "/run/neuravps-unblock-ip.lock"
# Nada de comillas, espacios de mas ni otros caracteres: el resto se rechaza.
REQUEST_RE = re.compile(r"\Aunblock ([0-9A-Fa-f:.]{2,45})\Z")
STATUS_RE = re.compile(r"\Astatus ([0-9A-Fa-f:.]{2,45})\Z")
ALLOW_RE = re.compile(r"\Aallow-vm ([0-9A-Fa-f:.]{2,45}) ([0-9]{1,4}(?:,[0-9]{1,4}){0,63})( console)?\Z")
NFT_TIMEOUT = 20

CUSTOMER_SET = "cust_allow"
# 30 dias, como la memoria de sesiones de sweepguard: el bloqueo dura 24 h pero
# vuelve (el cliente del 22/10 fue rebloqueado tres dias seguidos), y mientras
# la entrada exista sweepguard no cuenta esos pares, asi que su propio trafico
# no lo vuelve a bloquear. Se renueva cada vez que entra en el panel bloqueado.
ALLOW_SECONDS = 30 * 86400
MAX_VMIDS = 50                  # el cliente con mas servidores tiene 7
VMID_MIN, VMID_MAX = 100, 9999  # los forwards son 1xxxx/2xxxx/3xxxx
FORWARD_BASES = (10000, 20000, 30000)   # SMB, RDP, SSH
CONSOLE_PORT = 443


class BadRequest(ValueError):
    pass


def _ip(raw):
    try:
        ip = ipaddress.ip_address(raw)
    except ValueError:
        raise BadRequest("not an IP address")
    if ip.version == 6 and ip.ipv4_mapped is not None:
        ip = ip.ipv4_mapped
    if not ip.is_global:
        raise BadRequest("not a global address")
    return ip


def _vmids(raw):
    out = []
    for tok in raw.split(","):
        if tok != str(int(tok)):             # sin ceros a la izquierda
            raise BadRequest("bad vmid")
        v = int(tok)
        if not VMID_MIN <= v <= VMID_MAX:
            raise BadRequest("vmid out of range")
        if v not in out:
            out.append(v)
    if len(out) > MAX_VMIDS:
        raise BadRequest(f"more than {MAX_VMIDS} vmids")
    return sorted(out)


def parse_request(raw):
    """`unblock <ip>` -> ipaddress normalizado. Lanza BadRequest."""
    m = REQUEST_RE.match(raw or "")
    if not m:
        raise BadRequest("expected: unblock <ip>")
    return _ip(m.group(1))


def parse_command(raw):
    """Peticion -> (orden, ip, vmids, consola). Lanza BadRequest.
    unblock <ip> | status <ip> | allow-vm <ip> <vmid>[,<vmid>...] [console]"""
    raw = raw or ""
    m = REQUEST_RE.match(raw)
    if m:
        return "unblock", _ip(m.group(1)), [], False
    m = STATUS_RE.match(raw)
    if m:
        return "status", _ip(m.group(1)), [], False
    m = ALLOW_RE.match(raw)
    if m:
        return "allow-vm", _ip(m.group(1)), _vmids(m.group(2)), bool(m.group(3))
    raise BadRequest("expected: unblock <ip> | status <ip> | allow-vm <ip> <vmid>[,...] [console]")


def vm_ports(vmids, console=False):
    ports = [b + v for v in vmids for b in FORWARD_BASES]
    return sorted(ports + ([CONSOLE_PORT] if console else []))


def family_of(ip):
    return "ip" if ip.version == 4 else "ip6"


def run(cmd, stdin=None):
    return subprocess.run(cmd, input=stdin, capture_output=True, text=True,
                          timeout=NFT_TIMEOUT)


def set_exists(fam, name):
    # -t: sin elementos (bf_static tiene ~14.000 en v4)
    return run(["nft", "-t", "list", "set", fam, TABLE, name]).returncode == 0


def in_set(fam, name, addr):
    """True/False si la direccion esta en el set. Solo se llama con sets que
    existen: un error que no sea «no esta» se propaga."""
    r = run(["nft", "get", "element", fam, TABLE, name, "{ %s }" % addr])
    if r.returncode == 0:
        return True
    if "No such file or directory" in r.stderr:
        return False
    raise RuntimeError(f"nft get element {name}: {' '.join(r.stderr.split())[:160]}")


def seen_ports(fam, addr, name="bf_seen"):
    """Puertos que `bf_seen` (o `cust_allow`) tiene anotados para esta fuente."""
    return [p for p, _ in pair_ports(fam, addr, name)]


def pair_ports(fam, addr, name):
    """[(puerto, segundos que le quedan o None)] de un set (addr . puerto)."""
    r = run(["nft", "-j", "list", "set", fam, TABLE, name])
    if r.returncode != 0:
        return []
    ports = []
    for obj in json.loads(r.stdout).get("nftables", []):
        for e in (obj.get("set") or {}).get("elem", []) or []:
            val = e.get("elem", {}).get("val") if isinstance(e, dict) else None
            concat = val.get("concat") if isinstance(val, dict) else None
            if not concat or len(concat) != 2:
                continue
            try:
                same = ipaddress.ip_address(str(concat[0])) == addr
            except ValueError:
                continue
            if same and isinstance(concat[1], int):
                exp = e["elem"].get("expires")
                ports.append((concat[1], exp if isinstance(exp, int) else None))
    return ports


def forget_seen(fam, addr, only=None):
    """Borra las entradas (addr . puerto) de bf_seen (solo las de `only` si se
    da). Devuelve cuantas."""
    ports = seen_ports(fam, addr)
    if only is not None:
        ports = [p for p in ports if p in only]
    if not ports:
        return 0
    batch = "".join(f"delete element {fam} {TABLE} bf_seen {{ {addr} . {p} }}\n"
                    for p in ports)
    if run(["nft", "-f", "-"], stdin=batch).returncode == 0:
        return len(ports)
    # Alguna caduco entre la lectura y el borrado: la transaccion entera falla.
    done = 0
    for p in ports:
        if run(["nft", "delete", "element", fam, TABLE, "bf_seen",
                "{ %s . %d }" % (addr, p)]).returncode == 0:
            done += 1
    return done


def flush_conntrack(fam, addr):
    r = run(["conntrack", "-D", "-f", "ipv4" if fam == "ip" else "ipv6",
             "-s", str(addr)])
    m = re.search(r"(\d+) flow entr", r.stderr + r.stdout)
    return int(m.group(1)) if m else 0


def unblock(ip):
    fam = family_of(ip)
    addr = str(ip)
    out = {"ip": addr, "family": fam}
    if set_exists(fam, "bf_static") and in_set(fam, "bf_static", addr):
        out["result"] = "static"
        return out
    if not in_set(fam, "bf_auto", addr):
        out["result"] = "not_blocked"
        return out
    r = run(["nft", "delete", "element", fam, TABLE, "bf_auto", "{ %s }" % addr])
    if r.returncode != 0 and in_set(fam, "bf_auto", addr):
        raise RuntimeError(f"nft delete bf_auto: {' '.join(r.stderr.split())[:160]}")
    out["result"] = "unblocked"
    out["seenForgotten"] = forget_seen(fam, ip)
    out["conntrackDeleted"] = flush_conntrack(fam, addr)
    return out


def status(ip):
    """Solo lectura: bloqueos y VMs ya abiertas en cust_allow para esta IP."""
    fam = family_of(ip)
    addr = str(ip)
    out = {"ip": addr, "family": fam, "result": "status",
           "static": bool(set_exists(fam, "bf_static") and in_set(fam, "bf_static", addr)),
           "blocked": in_set(fam, "bf_auto", addr),
           "customerSet": set_exists(fam, CUSTOMER_SET)}
    if out["customerSet"]:
        left = dict(pair_ports(fam, ip, CUSTOMER_SET))
        vms = {}
        for p, exp in left.items():
            if p == CONSOLE_PORT or not 10000 <= p <= 39999:
                continue
            v = p % 10000
            trio = [left.get(b + v) for b in FORWARD_BASES]
            if all(isinstance(x, int) for x in trio):
                vms[str(v)] = min(trio)          # la VM esta abierta si lo estan sus 3 puertos
        out["allowedVmids"] = vms
        if isinstance(left.get(CONSOLE_PORT), int):
            out["consoleExpires"] = left[CONSOLE_PORT]
    return out


def allow_vm(ip, vmids, console):
    """Abre a esta IP solo los puertos de esas VMs (ver docstring del modulo)."""
    fam = family_of(ip)
    addr = str(ip)
    out = {"ip": addr, "family": fam, "vmids": vmids}
    if set_exists(fam, "bf_static") and in_set(fam, "bf_static", addr):
        out["result"] = "static"
        return out
    if not set_exists(fam, CUSTOMER_SET):
        raise RuntimeError(f"set {fam} {TABLE} {CUSTOMER_SET} missing (deploy_customer_allow.sh)")
    if not in_set(fam, "bf_auto", addr):
        out["result"] = "not_blocked"
        return out
    ports = vm_ports(vmids, console)
    present = set(seen_ports(fam, ip, CUSTOMER_SET)) & set(ports)
    # borrar y volver a meter en la MISMA transaccion renueva el plazo sin hueco
    batch = "".join(f"delete element {fam} {TABLE} {CUSTOMER_SET} {{ {addr} . {p} }}\n"
                    for p in sorted(present))
    batch += "".join(f"add element {fam} {TABLE} {CUSTOMER_SET} {{ {addr} . {p} timeout {ALLOW_SECONDS}s }}\n"
                     for p in ports)
    if run(["nft", "-f", "-"], stdin=batch).returncode != 0:
        # alguna caduco entre la lectura y el borrado: una a una
        failed = 0
        for p in ports:
            run(["nft", "delete", "element", fam, TABLE, CUSTOMER_SET, "{ %s . %d }" % (addr, p)])
            if run(["nft", "add", "element", fam, TABLE, CUSTOMER_SET,
                    "{ %s . %d timeout %ds }" % (addr, p, ALLOW_SECONDS)]).returncode != 0:
                failed += 1
        if failed:
            raise RuntimeError(f"nft add {CUSTOMER_SET}: {failed} of {len(ports)} failed")
    out["result"] = "allowed"
    out["ports"] = len(ports)
    out["renewed"] = len(present)
    out["console"] = console
    out["seenForgotten"] = forget_seen(fam, ip, set(ports))
    return out


def main(argv):
    raw = os.environ.get("SSH_ORIGINAL_COMMAND")
    if raw is None:                      # a mano: neuravps-unblock-ip status <ip>
        raw = " ".join(argv[1:])
    via = "ssh" if "SSH_ORIGINAL_COMMAND" in os.environ else "local"
    syslog.openlog("neuravps-unblock-ip")
    try:
        verb, ip, vmids, console = parse_command(raw)
    except BadRequest as exc:
        syslog.syslog(syslog.LOG_WARNING, f"rejected ({via}): {exc}: {raw[:80]!r}")
        print(json.dumps({"ok": False, "error": "bad_request", "detail": str(exc)}))
        return 2
    try:
        if verb == "status":                 # solo lectura: sin cerrojo
            out = status(ip)
        else:
            with open(LOCK, "w") as fh:
                fcntl.flock(fh, fcntl.LOCK_EX)
                out = unblock(ip) if verb == "unblock" else allow_vm(ip, vmids, console)
    except Exception as exc:  # noqa: BLE001
        syslog.syslog(syslog.LOG_ERR, f"{verb} {ip} ({via}): error {exc}")
        print(json.dumps({"ok": False, "ip": str(ip), "error": "internal",
                          "detail": str(exc)[:200]}))
        return 1
    out["ok"] = True
    syslog.syslog(syslog.LOG_INFO if verb == "status" else syslog.LOG_NOTICE,
                  f"{verb} {ip} ({via}): {json.dumps(out, sort_keys=True)}")
    print(json.dumps(out, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
