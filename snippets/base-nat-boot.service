[Unit]
Description=BASE NAT64 (Jool) + DNAT sync from Firestore
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Run via bash so curl -o installs (non-executable 644) still work; avoids 203/EXEC.
ExecStart=/bin/bash /usr/local/sbin/base-nat-boot.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
