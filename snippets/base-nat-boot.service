[Unit]
Description=BASE nftables + nginx stream sync from Firestore
After=network-online.target nginx.service
Wants=network-online.target nginx.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/base-nat-boot.sh
LimitNOFILE=262144
Restart=on-failure
RestartSec=15s
TimeoutStartSec=10min
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
